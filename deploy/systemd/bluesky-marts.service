[Unit]
Description=Build and test the marts with dbt in Athena, then export the dashboard's numbers
After=network-online.target
Wants=network-online.target
OnFailure=bluesky-alert@%n.service

[Service]
Type=oneshot
User=bluesky
Group=bluesky
WorkingDirectory=/var/lib/bluesky
EnvironmentFile=/etc/bluesky/process.env
EnvironmentFile=-/etc/bluesky/monitor.env
ExecStart=/opt/bluesky-stream-analytics/.venv/bin/dbt build --project-dir /opt/bluesky-stream-analytics/transform --profiles-dir /opt/bluesky-stream-analytics/transform
# Then the totals the public dashboard shows.
ExecStart=/opt/bluesky-stream-analytics/.venv/bin/export-dashboard --bucket ${BUCKET}
ExecStartPost=/opt/bluesky-stream-analytics/.venv/bin/ping-check bluesky-marts
# The checkout is read-only to the service, so dbt writes its files here instead.
Environment=DBT_TARGET_PATH=/var/lib/bluesky/dbt/target
Environment=DBT_LOG_PATH=/var/lib/bluesky/dbt/logs
Environment=DBT_SEND_ANONYMOUS_USAGE_STATS=false
Environment=PYTHONUNBUFFERED=1
Nice=10
StateDirectory=bluesky
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
