[Unit]
Description=Append uploaded Bluesky event files to the event store (started hourly by Airflow)
After=network-online.target
Wants=network-online.target
OnFailure=bluesky-alert@%n.service

[Service]
Type=oneshot
User=bluesky
Group=bluesky
WorkingDirectory=/var/lib/bluesky
EnvironmentFile=/etc/bluesky/process.env
EnvironmentFile=-/etc/bluesky/monitor.env
# The lock keeps it from committing to the tables while compaction does.
ExecStart=/usr/bin/flock /var/lib/bluesky/lake.lock /opt/bluesky-stream-analytics/.venv/bin/process --warehouse s3://${BUCKET}/warehouse --data-dir /var/lib/bluesky --extension-dir /var/lib/bluesky/duckdb-extensions
ExecStartPost=/opt/bluesky-stream-analytics/.venv/bin/ping-check bluesky-process
MemoryMax=4G
Environment=PYTHONUNBUFFERED=1
Nice=10
StateDirectory=bluesky
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
