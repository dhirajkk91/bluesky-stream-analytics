[Unit]
Description=Check the collector, the file backlog, the disk and Kafka, and report to healthchecks.io

[Service]
Type=oneshot
User=bluesky
Group=bluesky
WorkingDirectory=/var/lib/bluesky
EnvironmentFile=-/etc/bluesky/monitor.env
ExecStart=/opt/bluesky-stream-analytics/.venv/bin/check-health --data-dir /var/lib/bluesky --kafka 127.0.0.1:9092
Environment=PYTHONUNBUFFERED=1
StateDirectory=bluesky
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
