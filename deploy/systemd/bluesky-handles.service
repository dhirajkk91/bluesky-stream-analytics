[Unit]
Description=Look up the handles of accounts whose identity changed (started hourly by Airflow, after project)
After=network-online.target
Wants=network-online.target
OnFailure=bluesky-alert@%n.service

[Service]
Type=oneshot
User=bluesky
Group=bluesky
WorkingDirectory=/var/lib/bluesky
EnvironmentFile=/etc/bluesky/process.env
EnvironmentFile=-/etc/bluesky/monitor.env
ExecStart=/usr/bin/flock /var/lib/bluesky/lake.lock /opt/bluesky-stream-analytics/.venv/bin/resolve-handles --warehouse s3://${BUCKET}/warehouse --extension-dir /var/lib/bluesky/duckdb-extensions
ExecStartPost=/opt/bluesky-stream-analytics/.venv/bin/ping-check bluesky-handles
MemoryMax=4G
Environment=PYTHONUNBUFFERED=1
Nice=10
StateDirectory=bluesky
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
