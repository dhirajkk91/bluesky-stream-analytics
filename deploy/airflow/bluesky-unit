#!/bin/sh
# Starts or stops one of the project's job units. The airflow user may run this,
# and nothing else, as root through sudo. The list below is everything it allows:
# not the collector, the uploader or the health check.
set -eu

if [ "$#" -ne 2 ]; then
    echo "usage: bluesky-unit start|stop <unit>" >&2
    exit 2
fi

case "$1" in
    start | stop) ;;
    *)
        echo "bluesky-unit: the action must be start or stop, not $1" >&2
        exit 2
        ;;
esac

# Letters, digits and @.- only: no spaces, slashes or newlines that could smuggle
# in a second unit or a path.
case "$2" in
    "" | *[!a-z0-9@.-]*)
        echo "bluesky-unit: not one of the project's job units: $2" >&2
        exit 2
        ;;
esac

if ! printf '%s\n' "$2" | grep -Eqx 'bluesky-(process|project|handles|compact|vacuum|export|marts@[0-9]{4}-[0-9]{2}-[0-9]{2})\.service'; then
    echo "bluesky-unit: not one of the project's job units: $2" >&2
    exit 2
fi

exec /usr/bin/systemctl "$1" "$2"
