[Unit]
Description=Airflow API server and UI, on localhost only
After=network-online.target postgresql.service
Wants=network-online.target postgresql.service

[Service]
Type=simple
User=airflow
Group=airflow
EnvironmentFile=/opt/bluesky-stream-analytics/deploy/airflow/airflow.env
EnvironmentFile=/etc/bluesky/airflow-secrets.env
ExecStart=/opt/airflow/venv/bin/airflow api-server --host 127.0.0.1 --port 8080 --workers 1
Restart=on-failure
RestartSec=10
TimeoutStopSec=120
MemoryMax=1G
StateDirectory=airflow
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
