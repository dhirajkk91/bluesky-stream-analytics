AIRFLOW_HOME=/var/lib/airflow
AIRFLOW__CORE__DAGS_FOLDER=/opt/bluesky-stream-analytics/orchestration/dags
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__CORE__PARALLELISM=4
AIRFLOW__CORE__LOAD_EXAMPLES=False
AIRFLOW__CORE__DEFAULT_TIMEZONE=utc
AIRFLOW__CORE__EXECUTION_API_SERVER_URL=http://127.0.0.1:8080/execution/
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://airflow@/airflow?host=/var/run/postgresql
AIRFLOW__DAG_PROCESSOR__REFRESH_INTERVAL=120
PYTHONDONTWRITEBYTECODE=1
