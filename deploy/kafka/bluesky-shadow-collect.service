[Unit]
Description=Bluesky Jetstream collector sending to Kafka, run beside the file collector for comparison
After=network-online.target kafka.service
Wants=network-online.target kafka.service

[Service]
Type=simple
User=bluesky
Group=bluesky
WorkingDirectory=/opt/bluesky-stream-analytics
ExecStart=/opt/bluesky-stream-analytics/.venv/bin/collect --data-dir /var/lib/bluesky/shadow/collector --kafka 127.0.0.1:9092
Environment=PYTHONUNBUFFERED=1
Restart=always
RestartSec=5
TimeoutStopSec=120
StateDirectory=bluesky
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only

[Install]
WantedBy=multi-user.target
